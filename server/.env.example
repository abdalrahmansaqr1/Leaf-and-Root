DATABASE_URL=postgresql://leaf_and_root:leaf_and_root_local@localhost:5434/leaf_and_root?schema=public
API_PORT=3001
NODE_ENV=development

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Lifetime of a login session, in days (1-365).
SESSION_TTL_DAYS=30
# Comma-separated browser origins allowed to call the API cross-origin. Leave empty to disable CORS.
# The Vite dev server proxies /api, so it is not needed for local web development.
CORS_ALLOWED_ORIGINS=
# Swagger UI at /api/docs. Defaults to true outside production; set explicitly to override.
SWAGGER_ENABLED=true
# Optional. Integration tests use this database; if unset it is DATABASE_URL's database + "_test".
# It must be local and its name must end in "_test".
# TEST_DATABASE_URL=postgresql://leaf_and_root:leaf_and_root_local@localhost:5434/leaf_and_root_test
